# ==============================================================================
# AllayOps Environment Variables Template
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# ==============================================================================

# --- Minecraft Server & Portable Launcher ---
MC_SERVER_PORT=2026
MC_RCON_PORT=25575
MC_RCON_PASSWORD=CHANGE_ME_STRONG_RCON_PASSWORD
MC_MANAGEMENT_SECRET=CHANGE_ME_STRONG_MANAGEMENT_SECRET

# Optional overrides (leave blank for auto-detection by start.bat)
# Recommended for 16GB Windows workstation: Xms=2G, Xmx=4G (or 4G/6G if dedicated)
MC_JAVA_XMS=2G
MC_JAVA_XMX=4G
MC_PRETOUCH=false
MC_AUTO_RESTART=false
MC_JAVA_EXE=
MC_EXTRA_JVM_ARGS=

# --- Research / Agentic Ops ---
OPENAI_API_KEY=
GEMINI_API_KEY=
LANGSMITH_API_KEY=
LOG_LEVEL=INFO
